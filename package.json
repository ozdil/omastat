{
  "name": "omastat",
  "version": "1.1.0",
  "description": "Privacy-preserving community hardware survey and statistics engine for Omarchy",
  "author": "Ozan Özdil (ozdil)",
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply omastat-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply omastat-db --remote",
    "test": "node --import ./test/register-hooks.mjs test/test-worker.mjs",
    "serve:local": "node --import ./test/register-hooks.mjs test/serve-local.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  }
}
